<odoo>
    <data>
        <record id = 'hms_department_tree_view' model = 'ir.ui.view'>
        <field name='name'>hms.department.tree.view</field>
        <field name='model'>hms.department</field>
        <field name='arch' type ='xml'>
        <tree>
            <field name='name'/>
            <field name='capacity'/>
            <field name='is_opened'/>
        </tree>
        </field> 
        </record>
        <record id="hms_department_form_view" model="ir.ui.view">
            <field name="name">hms.department.form.view</field>
            <field name="model">hms.department</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Department Info">
                            <field name="name"/>
                            <field name="capacity"/>
                            <field name="is_opened"/>
                            <field name="patient_ids" string="Patients">
                                <tree>
                                    <field name="first_name"/>
                                    <field name="last_name"/>
                                    <field name="state"></field>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="HMS_departments_action" model="ir.actions.act_window">
            <field name="name">Department</field>
            <field name="res_model">hms.department</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem
    id="hms_department_menu"
    name="Departments"
    parent="HMS_menu"
    action="HMS_departments_action"
    sequence="2"/>

    </data>
</odoo>
